#!/usr/bin/env bash
# vigil-queue — FIFO queue engine CLI: enqueue/dequeue/peek/count.
#
# Standalone: requires no running tmux(1) or kitty process. All writes
# go through a flock-guarded critical section + temp-file + atomic rename;
# peek/count are lock-free reads (see cmd_peek below for why that's safe).
set -euo pipefail

# shellcheck disable=SC1091 # dynamic, self-locating path; not statically resolvable
source "${BASH_SOURCE[0]%/*}/lib/vigil-common.sh"

# _vigil_mutation <fn> [args...]
#
# Runs a mutating locked command through the shared queue lock, then
# republishes the UI state. vigil_with_lock keeps the lock FD open until
# process exit, so the publish below is still inside the critical section
# (D-03). A publish failure must never fail the mutation (D-05).
_vigil_mutation() {
	local status=0
	vigil_with_lock "$@" || status=$?
	if [[ "$status" -ne 0 ]]; then
		return "$status"
	fi
	vigil_publish_state || true
	return 0
}

# _vigil_write_queue_atomic <json>
#
# Writes <json> to a same-directory temp file, then atomically `mv`s it
# onto the real queue file. VIGIL_QUEUE_TEST_DELAY is a deliberate
# fault-injection seam (Plan 03's crash-safety tests): if set, it sleeps
# between the tmp-file write and the mv, never before the write, so a
# process killed mid-delay still leaves the old queue file intact.
_vigil_write_queue_atomic() {
	local content="$1"
	local queue_file tmp_file
	queue_file="$(vigil_queue_file)"
	tmp_file="${queue_file}.tmp.$$"
	printf '%s' "$content" >"$tmp_file"
	if [[ -n "${VIGIL_QUEUE_TEST_DELAY:-}" ]]; then
		# CR-01: run the fault-injection sleep in a subshell that closes
		# this process's copy of the lock FD first. Without this, a
		# SIGKILL to the holder while this sleep is still running leaves
		# an orphaned `sleep` holding a copy of the lock's file
		# description, and flock keeps the lock held until that orphan
		# also exits -- dropping the next mutation with exit 2.
		(
			_vigil_close_lock_fd
			sleep "$VIGIL_QUEUE_TEST_DELAY"
		)
	fi
	# Same reasoning applies to `mv`: it is quick in practice, but if the
	# holder is killed mid-rename, an inherited lock FD would still keep
	# the orphaned `mv` -- however briefly -- holding the lock.
	(
		_vigil_close_lock_fd
		mv -f "$tmp_file" "$queue_file"
	) # atomic publish: *.tmp.$$ -> queue.json
}

# _vigil_read_queue
#
# Echoes the current queue contents, defaulting to an empty queue if the
# file doesn't exist yet. Treats a jq parse failure, or a syntactically
# valid JSON document that doesn't match the expected
# {"queue": [{"pane_id": "..."}]} shape -- e.g. {"queue":null} (WR-01,
# prior iteration) or {"queue":["x"]}/non-object elements (WR-02, this
# iteration) -- as corrupted state (T-02-05) and exits 1 with a clear
# stderr message rather than silently truncating, crashing with a raw jq
# error on a mutating subcommand, or returning misleading-but-plausible
# output on a read-only one (e.g. peek echoing a bare string instead of
# the documented corruption error).
_vigil_read_queue() {
	local queue_file content
	queue_file="$(vigil_queue_file)"
	if [[ ! -s "$queue_file" ]]; then
		printf '%s' '{"queue":[]}'
		return
	fi
	content="$(cat "$queue_file")"
	if ! (
		_vigil_close_lock_fd
		jq -e 'has("queue") and (.queue | type == "array") and
			(.queue | all(type == "object" and has("pane_id") and (.pane_id | type == "string")))' \
			<<<"$content" >/dev/null 2>&1
	); then
		echo "vigil-queue: queue file is corrupted" >&2
		exit 1
	fi
	printf '%s' "$content"
}

# cmd_enqueue <pane_id> — idempotent append under lock.
cmd_enqueue() {
	local pane_id="${1:?pane_id required}"
	_vigil_mutation _cmd_enqueue_locked "$pane_id"
}

_cmd_enqueue_locked() {
	local pane_id="$1"
	local current updated
	current="$(_vigil_read_queue)"

	if (
		_vigil_close_lock_fd
		jq -e --arg p "$pane_id" '.queue[] | select(.pane_id == $p)' <<<"$current" >/dev/null
	); then
		return 0
	fi

	updated="$(
		_vigil_close_lock_fd
		jq --arg p "$pane_id" --arg t "$(vigil_now_iso)" \
			'.queue += [{"pane_id":$p,"enqueued_at":$t}]' <<<"$current"
	)"
	_vigil_write_queue_atomic "$updated"
}

# cmd_dequeue <pane_id> — removes the entry if present; unconditional no-op
# write if absent (the filter simply keeps everything).
cmd_dequeue() {
	local pane_id="${1:?pane_id required}"
	_vigil_mutation _cmd_dequeue_locked "$pane_id"
}

_cmd_dequeue_locked() {
	local pane_id="$1"
	local current updated
	current="$(_vigil_read_queue)"
	updated="$(
		_vigil_close_lock_fd
		jq --arg p "$pane_id" '.queue |= map(select(.pane_id != $p))' <<<"$current"
	)"
	_vigil_write_queue_atomic "$updated"
}

# cmd_rotate — moves the current head to the tail, refreshing its
# enqueued_at to "now" (Claude's Discretion: a rotated pane re-enters the
# wait queue as of the moment it was explicitly deferred, not its original
# arrival time), then prints the new head's pane_id.
cmd_rotate() {
	_vigil_mutation _cmd_rotate_locked
}

_cmd_rotate_locked() {
	local current len updated
	current="$(_vigil_read_queue)"
	len="$(
		_vigil_close_lock_fd
		jq '.queue | length' <<<"$current"
	)"

	if [[ "$len" -eq 0 ]]; then
		echo "vigil-queue: queue is empty, nothing to rotate" >&2
		exit 1
	fi

	updated="$(
		_vigil_close_lock_fd
		jq --arg t "$(vigil_now_iso)" \
			'.queue[0].enqueued_at = $t | .queue += [.queue[0]] | .queue |= .[1:]' <<<"$current"
	)"
	_vigil_write_queue_atomic "$updated"

	(
		_vigil_close_lock_fd
		jq -r '.queue[0].pane_id' <<<"$updated"
	)
}

# cmd_prune [live_pane_id...] — removes every queue entry whose pane_id is
# not in the injected live_pane_ids list, preserving the original relative
# order of survivors. Deliberately never shells out to tmux(1) itself
# (T-02-08): the caller (a future lifecycle hook) is responsible for
# sourcing the live list by listing panes via tmux(1); this is the
# unit-testable seam.
cmd_prune() {
	_vigil_mutation _cmd_prune_locked "$@"
}

_cmd_prune_locked() {
	local live_json updated
	# Build a JSON array from the positional args without ever
	# string-interpolating them into a jq program (T-02-04). Handles the
	# zero-arg case: `printf '%s\n'` with no data args still emits one
	# newline, so split("\n") yields [""], which select(length > 0) drops,
	# leaving [].
	live_json="$(
		_vigil_close_lock_fd
		printf '%s\n' "$@" | jq -R -s -c 'split("\n") | map(select(length > 0))'
	)"
	updated="$(
		_vigil_close_lock_fd
		_vigil_read_queue | jq --argjson live "$live_json" \
			'.queue |= map(select(.pane_id as $p | $live | index($p) != null))'
	)"
	_vigil_write_queue_atomic "$updated"

	(
		_vigil_close_lock_fd
		jq '.queue | length' <<<"$updated"
	)
}

# cmd_peek — echoes the head entry (longest-waiting pane) or null.
#
# No lock needed: atomic mv-based publication guarantees any read sees
# either the complete old file or the complete new file, never a partial
# one, so peek/count are lock-free by design.
cmd_peek() {
	_vigil_read_queue | jq '.queue[0] // null'
}

# cmd_count — echoes the number of entries currently queued.
cmd_count() {
	_vigil_read_queue | jq '.queue | length'
}

case "${1:-}" in
enqueue)
	shift
	cmd_enqueue "$@"
	;;
dequeue)
	shift
	cmd_dequeue "$@"
	;;
rotate)
	cmd_rotate
	;;
prune)
	shift
	cmd_prune "$@"
	;;
peek)
	cmd_peek
	;;
count)
	cmd_count
	;;
*)
	echo "vigil-queue: unknown subcommand '${1:-}'" >&2
	exit 1
	;;
esac
