#!/usr/bin/env bash
# vigil-advance — Alt+v handler (NAV-01/NAV-02/NAV-03): jump to the
# FIFO head when not already on it, or rotate the head to the back
# and jump to the new head when already on it. Runs a lazy
# prune-on-read backstop before every navigation decision -- the
# self-healing half of QUEUE-03 (05-CONTEXT.md's two-layer design):
# pane-exited (vigil.tmux's hook, wired to vigil-prune) is the fast
# path for a normal process exit, but it never fires for
# kill-pane/kill-session/kill-server (PITFALLS.md Pitfall 6,
# empirically confirmed), so this script cannot assume the queue it
# reads is already clean.
#
# Invoked via vigil.tmux's `bind-key -n M-v run-shell -b <this
# script>`. tmux sets $TMUX for run-shell-spawned processes to the
# invoking server's own socket (empirically verified against a
# custom -L/$TMUX_TMPDIR server, not assumed from docs), so
# vigil_runtime_dir resolves correctly with zero extra wiring --
# this is NOT a Claude Code hook, so none of vigil-hook-common.sh's
# TMUX_PANE/fail-open machinery applies. This script's own "what
# pane is the user on" question is answered via `tmux
# display-message -p '#{pane_id}'`, which is exactly correct here
# (unlike Pitfall 9's warning against that same call inside a
# Claude Code hook, where it would return the wrong pane).
set -euo pipefail

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091 # dynamic, self-locating path; not statically resolvable
source "$CURRENT_DIR/lib/vigil-common.sh"

# Outside tmux (e.g. invoked by hand during development with no
# $TMUX) this is a silent no-op, mirroring vigil-publish/
# vigil.tmux's own guard.
if ! vigil_in_tmux; then
	exit 0
fi

VIGIL_QUEUE="$CURRENT_DIR/vigil-queue"

# vigil_advance_flash <message> — ends the run with tmux's own
# ephemeral status-line message (NAV-03), no focus change. Factored
# out because both the empty-queue case and the retries-exhausted
# fail-safe below reach the identical outcome.
vigil_advance_flash() {
	tmux display-message "$1"
	exit 0
}

# Bounded retry: each iteration prunes dead entries then re-derives
# a target, so a second (or third...) pass only happens when the
# chosen target died in the narrow race window between this
# iteration's prune and its own switch-client attempt --
# vanishingly rare in practice. 64 is comfortably above any
# realistic queue depth (Claude's Discretion, 05-CONTEXT.md);
# exhausting it would mean something is non-convergent, which the
# fail-safe flash below reports distinctly from a genuinely empty
# queue (WR-03) rather than erroring or leaving focus undefined.
#
# WR-04 (accepted tradeoff): each iteration can invoke up to two
# lock-guarded vigil-queue subcommands (prune, and conditionally
# rotate), each independently subject to vigil_with_lock's hardcoded
# 2s `flock -w 2` timeout (vigil-common.sh). Under sustained lock
# contention, the full retry loop can therefore legitimately take up
# to roughly `64 x (2s + 2s) ~ 4+ minutes` before falling through to
# the fail-safe flash -- a multi-minute stall is effectively a hang
# from the user's perspective even though it is technically bounded.
# This is accepted given Phase 2's existing 2s lock-timeout design:
# tightening it would mean lowering a timeout shared by every
# vigil-queue caller, not something to special-case just for this
# interactive path.
MAX_ATTEMPTS=64
attempt=0
while ((attempt < MAX_ATTEMPTS)); do
	attempt=$((attempt + 1))

	# Lazy prune-on-read backstop (QUEUE-03): reconcile against every
	# pane on this server, all sessions, not just the current one
	# (05-CONTEXT.md's "Live-pane-list source" decision; matches
	# vigil-queue's own tmux-independent design). CR-01: only prune
	# when list-panes itself actually succeeded -- a transient
	# list-panes failure (socket contention, server hiccup, ...) must
	# NOT be treated identically to "the server genuinely has zero
	# panes", or prune would wipe every genuinely-live entry in the
	# queue. On failure, skip pruning for this attempt (a safe no-op;
	# switch-client's own exit status below remains the real safety
	# net for a dead target) and surface the failure on stderr instead
	# of silently discarding it.
	if live_panes="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)"; then
		# shellcheck disable=SC2086 # intentional word-splitting: one pane_id per arg
		"$VIGIL_QUEUE" prune $live_panes >/dev/null 2>&1 || true
	else
		echo "vigil-advance: tmux list-panes failed, skipping prune for this attempt" >&2
	fi

	# WR-01: distinguish a genuinely empty queue from a `peek` failure
	# (e.g. a corrupted queue.json tripping _vigil_read_queue's shape
	# validation) -- both must still fail open (no crash, no hang), but
	# reporting them identically as "nothing waiting" would permanently
	# mask real corruption from ever showing up in a user report.
	if ! head_json="$("$VIGIL_QUEUE" peek)"; then
		echo "vigil-advance: queue peek failed (possibly corrupted queue.json)" >&2
		vigil_advance_flash "Vigil: queue error"
	fi
	head_pane="$(jq -r '.pane_id // empty' <<<"${head_json:-null}" 2>/dev/null || true)"

	if [[ -z "$head_pane" ]]; then
		vigil_advance_flash "Vigil: nothing waiting"
	fi

	current_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"

	if [[ -n "$current_pane" && "$current_pane" == "$head_pane" ]]; then
		# NAV-02: already on the head -- rotate it to the back and
		# jump to the pane that was waiting second-longest.
		# vigil-queue rotate returns the new head's pane_id directly
		# on its own stdout (Phase 2), so there is no separate peek
		# call and no race window between rotating and reading the
		# new head (05-CONTEXT.md's Rotate-and-Jump Semantics).
		#
		# WR-02 (accepted, bounded risk): `rotate` re-reads the queue
		# fresh under its own lock rather than asserting the head is
		# still `$head_pane` -- there is a narrow TOCTOU window
		# between the lock-free `peek` above (lock-free by design,
		# Phase 2) and rotate's lock acquisition where a concurrent
		# dequeue could change the head. If that race lands, rotate
		# mutates whatever IS the head at that moment rather than the
		# pane this iteration actually confirmed the user was on.
		# This does not violate the "never lands on/errors on a dead
		# pane" guarantee -- switch-client's own exit status below
		# still protects that -- it only means a different-but-still-
		# queued pane could get rotated to the back than the one
		# verified here. The window is narrow and the outcome stays
		# correct (a live, queued pane), so this is judged tolerable
		# rather than worth a compare-and-swap `--if-head` parameter
		# on `vigil-queue rotate`.
		target="$("$VIGIL_QUEUE" rotate)" || continue
	else
		# NAV-01: not on the head -- read-only jump, no queue
		# mutation.
		target="$head_pane"
	fi

	# switch-client's own exit status IS the liveness check -- do
	# NOT pre-flight with `tmux display-message -p -t "$target"
	# '#{pane_id}'` first: empirically, that command returns exit 0
	# with EMPTY output for a nonexistent pane (it does not error),
	# so it cannot distinguish a dead target from a live one.
	# switch-client correctly fails (exit 1, "can't find pane") and
	# changes nothing when $target no longer exists.
	if tmux switch-client -t "$target" 2>/dev/null; then
		exit 0
	fi
	# $target died between the prune above and this switch-client
	# attempt; loop again so the next iteration's prune removes it
	# for real.
done

# Unreachable in any normal run (every iteration either exits or
# removes the one dead target it just found) -- but if it is ever
# reached, the queue is NOT converging (a pathological case, e.g. a
# queue entry being repeatedly re-raced/killed faster than this loop
# can prune it). WR-03: flash a message distinct from the normal
# empty-queue case (rather than "Vigil: nothing waiting") so this
# anomaly stays observable instead of looking identical to the
# common, benign empty-queue outcome.
echo "vigil-advance: retries exhausted ($MAX_ATTEMPTS attempts) without converging" >&2
vigil_advance_flash "Vigil: queue busy, try again"
