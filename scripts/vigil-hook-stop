#!/usr/bin/env bash
# vigil-hook-stop — Claude Code Stop hook client. Enqueues the pane
# whose session just finished a turn (DETECT-02's Stop half). Pane
# identity comes ONLY from $TMUX_PANE, captured at invocation time --
# never from a tmux query -- per CONTEXT.md's Pane Identity decision.
#
# Dedup (DETECT-04) needs no special-casing here: vigil-queue enqueue
# is already idempotent per pane_id (Phase 2), so a Stop immediately
# followed by an allow-listed Notification for the same pane naturally
# collapses to one entry -- see test/unit/hook_dedup.bats.
set -euo pipefail

# DETECT-05: fail-open across every failure mode we can control. The
# EXIT trap unconditionally converts internal failures (a `set -e`
# abort, an explicit `exit N`, a failing vigil-queue call) to exit 0.
# That alone does not cover termination by an external signal: bash
# runs the EXIT trap on signal death too, but then re-raises the
# signal itself unless a handler is registered on it directly, which
# would otherwise surface to Claude Code as exit 143/130/129 (TERM/
# INT/HUP) instead of 0. The explicit traps below close that gap.
# SIGKILL cannot be trapped by any process and is out of scope -- the
# outer bound there is Claude Code's own hook `timeout` field in
# settings.json (04-CONTEXT.md), not this script.
trap 'exit 0' EXIT
trap 'exit 0' TERM INT HUP

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091 # dynamic, self-locating path; not statically resolvable
source "$CURRENT_DIR/lib/vigil-common.sh"
# shellcheck disable=SC1091
source "$CURRENT_DIR/lib/vigil-hook-common.sh"

json="$(vigil_hook_read_stdin)"
vigil_hook_debug "Stop fired (hook_event_name=$(vigil_hook_jq_field "$json" hook_event_name unknown))"

pane_id="$(vigil_hook_pane_id)" || {
    vigil_hook_debug "TMUX_PANE unset, no-op"
    exit 0
}

# Subagent guard: Stop also fires when the main thread yields to a running
# subagent, which is not waiting on the user. Skip the enqueue while any
# subagent is active -- the main thread's later Stop (after the subagent
# finishes and the turn really ends) fires with the counter back at 0 and
# enqueues then. Count is maintained by vigil-hook-subagent.
subagents="$(vigil_subagent_count "$pane_id")"
if [[ "$subagents" -gt 0 ]]; then
    vigil_hook_debug "Stop with $subagents subagent(s) running, not enqueueing"
    exit 0
fi

"$CURRENT_DIR/vigil-queue" enqueue "$pane_id" || vigil_hook_debug "enqueue failed (ignored, fail-open)"

# AUTO-02: pull-on-enqueue. Every successful enqueue re-pulls while
# auto mode is on (06-RESEARCH.md Open Question 1's adopted
# recommendation -- no debounce here; vigil-kitty-focus's own
# @vigil_kitty_focused gate, Plan 06-01, is what actually prevents
# a redundant pull once the terminal is focused). Fired detached
# (&/disown): a slow/hung kitten or tmux IPC round-trip must never
# delay this hook's own fail-open exit (DETECT-05). Gated on $TMUX
# being set BEFORE the bare tmux call (mirrors vigil_in_tmux's
# check, used by every other Vigil script) -- without this, a
# $TMUX-unset invocation does not fail closed, it can silently
# reach an unrelated ambient default-socket tmux server instead.
if [[ -n "${TMUX:-}" ]]; then
    auto="$(tmux show-options -gv @vigil_auto 2>/dev/null || true)"
    if [[ "$auto" == "on" ]]; then
        head_json="$("$CURRENT_DIR/vigil-queue" peek 2>/dev/null || true)"
        head_pane="$(jq -r '.pane_id // empty' <<<"${head_json:-null}" 2>/dev/null || true)"
        if [[ -n "$head_pane" ]]; then
            "$CURRENT_DIR/vigil-kitty-focus" pull "$head_pane" &
            disown 2>/dev/null || true
        fi
    fi
fi
