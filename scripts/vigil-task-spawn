#!/usr/bin/env bash
# vigil-task-spawn <task_file> — DEDUP-01/DEDUP-02/SPAWN-01/SPAWN-02:
# given one task note's absolute file path (already produced by
# vigil-task-reader), spawns a tmux window + `claude` session inside
# a managed `eip` tmux session for it, unless a window with that
# task's deterministic name already exists -- exact tmux window-name
# existence is the sole liveness/dedup signal (no daemon, no
# persisted state file). Single-task operation: does not loop over a
# directory itself (08-CONTEXT.md "CLI Shape") -- Phase 10's cron
# packaging composes this with vigil-task-reader's own output, one
# invocation per line.
#
# Idempotent: running this twice against the same task_file produces
# exactly one window, not two (DEDUP-01's own success criterion) --
# T-08-02 below is why a tmux `-t` target probe cannot be used for
# this check; only explicit `list-windows` enumeration + exact
# string comparison is correct (08-RESEARCH.md Pitfall 1 and Pitfall
# 5: tmux itself does NOT reject a duplicate window name, so the
# dedup check here is the entire guarantee, not a backstop on top of
# one).
#
# The spawned window runs `claude --permission-mode auto` (so the
# session starts in auto mode even though no human is attached to
# Shift+Tab it), and the prompt body is handed over through a temp
# file read inside the window -- tmux rejects command strings over
# ~16 KiB, which PR-rendered prompts routinely exceed. A persistent
# `vigil-home` window keeps eip alive when the human quits claude;
# see vigil_ensure_home_window below.
#
# Deliberately does NOT source vigil-common.sh or guard on
# vigil_in_tmux: this script must work correctly with $TMUX unset
# (every cron invocation, Phase 10) -- plain `tmux` calls with no
# -L/-S flag correctly resolve to the default socket regardless
# (08-RESEARCH.md Pitfall 4).
set -euo pipefail

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091 # dynamic, self-locating path; not statically resolvable
source "$CURRENT_DIR/lib/vigil-frontmatter.sh"

task_file="${1:-}"
if [[ -z "$task_file" ]]; then
	echo "usage: vigil-task-spawn <task_file>" >&2
	exit 1
fi

# Re-derive `id` independently from the task file itself rather than
# trusting a caller-supplied value (08-CONTEXT.md "Identity & Window
# Naming") -- keeps this script correct and testable standalone, not
# dependent on vigil-task-reader having already validated anything.
if ! vigil_frontmatter_parse "$task_file"; then
	echo "vigil-task-spawn: $task_file: unparseable frontmatter" >&2
	exit 1
fi

id="${VIGIL_FM[id]:-}"
# Same shape gate as vigil-task-reader's own T-07-07 fix (14-digit
# timestamp) -- a missing or malformed id here must never silently
# flow into the window name (T-08-05: it could otherwise produce an
# ambiguous/empty "vigil-task-" name or corrupt the exact-match
# comparison below).
if [[ ! "$id" =~ ^[0-9]{14}$ ]]; then
	echo "vigil-task-spawn: $task_file: id field is not a 14-digit timestamp" >&2
	exit 1
fi

# DEBT-02 (v1.1 audit): re-check the note's assignee here, exactly as
# vigil-task-reader does, so a standalone invocation is as strict as
# the composed cron flow. Deliberately placed before any tmux call --
# a misfiled note must never even create the `eip` session. The
# configured slug is the same hardcoded value the reader uses (one
# constant, duplicated rather than extracted, matching the reader's
# own style).
VIGIL_TASK_ASSIGNEE="samuel"
if [[ "${VIGIL_FM[assignee]:-}" != "$VIGIL_TASK_ASSIGNEE" ]]; then
	echo "vigil-task-spawn: $task_file: assignee mismatch" >&2
	exit 1
fi

window_name="vigil-task-$id"

# Resolve claude's absolute path in THIS process's own PATH, before
# ever touching tmux (08-RESEARCH.md Pitfall 2): a spawned window's
# shell inherits the tmux SERVER's environment snapshot from when
# the server first started, not the PATH of whatever client later
# issues new-session/new-window -- a bare "claude" word in the
# command string would silently resolve to whatever the server saw
# at startup, breaking both test-stubbing and any later PATH
# change. VIGIL_CLAUDE_BIN is a test seam only (T-08-03, accepted:
# never exposed to an untrusted caller in the real cron invocation).
claude_bin="$(command -v "${VIGIL_CLAUDE_BIN:-claude}")" || {
	echo "vigil-task-spawn: claude binary not found on PATH" >&2
	exit 1
}

# SPAWN-03: reuse the VIGIL_FM_BODY already produced by the
# vigil_frontmatter_parse call made earlier in this same script (no
# second read of task_file) -- the note's own markdown body is what
# reaches the prompt by default, instead of a bare @<path> reference.
prompt_body="${VIGIL_FM_BODY:-}"

# SPAWN-04: if the body links a GitHub PR, try to fold that PR's
# actual review/comment content into the prompt instead -- fails
# open to the raw note body on ANY gh failure or surprising
# empty-but-successful result, mirroring vigil-task-done-check's own
# gh fail-open contract (09-CONTEXT.md "GitHub Query"). The captured
# org/repo/number substrings are restricted to [A-Za-z0-9_.-]+ /
# [0-9]+ by the regex itself -- no shell metacharacter can survive
# that charset -- and are passed to gh as separate argv elements,
# never interpolated into a re-evaluated shell string (T-SPAWN-04-01).
if [[ "$prompt_body" =~ github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/pull/([0-9]+) ]]; then
	pr_org="${BASH_REMATCH[1]}"
	pr_repo="${BASH_REMATCH[2]}"
	pr_number="${BASH_REMATCH[3]}"
	pr_jq='(.body // "") as $body
		| ([.reviews[]? | select(.body != "") | "Review by " + (.author.login // "unknown") + ": " + .body]) as $reviews
		| ([.comments[]? | select(.body != "") | "Comment by " + (.author.login // "unknown") + ": " + .body]) as $comments
		| ([$body] + $reviews + $comments | map(select(. != "")) | join("\n\n"))'
	# The jq filter is applied locally (via a separate `jq` call on
	# gh's captured raw JSON) rather than via gh's own --jq flag, the
	# same two-step capture-then-filter shape vigil-task-done-check
	# already uses -- this keeps the filtering testable against a
	# dumb PATH-stub `gh` that only echoes canned JSON back verbatim.
	if raw_pr_json="$(gh pr view "$pr_number" --repo "$pr_org/$pr_repo" --json reviews,comments,body 2>/dev/null)" &&
		pr_content="$(jq -r "$pr_jq" <<<"$raw_pr_json" 2>/dev/null)" && [[ -n "$pr_content" ]]; then
		prompt_body="$pr_content"
	fi
fi

# Spawned sessions must start in auto permission mode. Relying on the
# user's ~/.claude/settings.json permissions.defaultMode is not enough
# here: a cron-spawned window resolves whatever `claude` is first on
# the systemd user manager's PATH (which can be a different, older
# build than the interactive shell's), and a session nobody is
# attached to can never be Shift+Tab'd into auto by hand. A command
# line flag has the highest precedence of all permission-mode sources.
permission_mode="auto"

# tmux caps the command string handed to new-session/new-window (tmux
# 3.7b rejects anything over ~16 KiB with "command too long"), and
# SPAWN-04 folds the linked PR's body/reviews/comments into the
# prompt, which routinely exceeds that -- a busy PR is tens of KB.
# Never put the prompt itself into the tmux command string. Write it
# to a private temp file instead and have the window's own shell read
# it back into ONE argv element at start-up. That shell removes the
# file immediately after reading it, so the normal path leaves nothing
# behind; the content never passes through tmux's parser at all, which
# also supersedes the T-08-01 printf '%q' escaping discipline (the
# prompt is now data read from a file, not shell syntax).
prompt_file="$(mktemp "${TMPDIR:-/tmp}/vigil-task-prompt.XXXXXX")"
printf '%s' "/thinking-partner ${prompt_body}" >"$prompt_file"
# mktemp's own charset is safe, but TMPDIR is caller-controlled and
# this path is re-parsed by the window's shell -- quote it anyway.
prompt_file_q="$(printf '%q' "$prompt_file")"
cmd="vigil_prompt=\$(cat $prompt_file_q); rm -f $prompt_file_q; exec $claude_bin --permission-mode $permission_mode \"\$vigil_prompt\""

# A tmux session dies with its last window, and DEDUP-01's only
# liveness signal is window-name existence. Without a keeper window,
# the first time the human quits a spawned claude (/exit, Ctrl-D,
# crash) that task window closes, eip loses its last window, and any
# attached client is dropped out of tmux -- the exact "quit claude and
# the session vanished" failure. Keep one dedicated `vigil-home` shell
# window in eip at all times. Quitting a task then closes only that
# task's window (so the next sweep can respawn it) while eip and the
# attached client survive. The home window is never a task identity:
# dedup below matches only exact `vigil-task-<id>` names, and the
# name cannot collide with them.
vigil_ensure_home_window() {
	local windows
	windows="$(tmux list-windows -t eip -F '#{window_name}' 2>/dev/null || true)"
	if ! grep -Fxq "vigil-home" <<<"$windows"; then
		tmux new-window -d -t eip -n "vigil-home"
	fi
}

# DEDUP-02: create `eip` if it doesn't exist yet, rather than
# failing. Both branches construct the identical window_name + cmd;
# only the tmux subcommand differs (08-CONTEXT.md "eip Session
# Lifecycle").
if tmux has-session -t eip 2>/dev/null; then
	# Retrofit the keeper window onto a pre-existing eip too, so an
	# older session created before this behavior existed also
	# survives its last task window closing. Done before dedup so a
	# "skipped" run still repairs the session.
	vigil_ensure_home_window
	# T-08-02 mitigation: exact-match via explicit enumeration,
	# NEVER a `-t "eip:$window_name"` target probe -- tmux's own
	# target resolution does prefix/glob matching, not exact
	# matching (08-RESEARCH.md Pattern 2/Pitfall 1), so a probe
	# would produce false positives against ids that share a
	# numeric prefix (task ids are 14-digit timestamps, and later
	# ids routinely share long prefixes with earlier ones).
	existing="$(tmux list-windows -t eip -F '#{window_name}' 2>/dev/null || true)"
	if grep -Fxq "$window_name" <<<"$existing"; then
		echo "skipped: $window_name (already running)"
		exit 0
	fi
	# -d: don't steal focus from a human who might be attached to
	# eip (08-RESEARCH.md Pattern 3 -- the new-session branch below
	# already has -d per the original locked decision; new-window
	# needs it added explicitly).
	tmux new-window -d -t eip -n "$window_name" "$cmd"
else
	tmux new-session -d -s eip -n "$window_name" "$cmd"
	vigil_ensure_home_window
fi

echo "spawned: $window_name (window created in eip)"
exit 0
